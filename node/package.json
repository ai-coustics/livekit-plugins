{
  "name": "@ai-coustics/livekit-agents",
  "version": "0.1.0",
  "description": "ai-coustics noise cancellation for LiveKit Agents",
  "license": "Apache-2.0",
  "author": "ai-coustics GmbH",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "check": "tsc --noEmit",
    "test": "vitest run test/processor.test.ts",
    "test:integration": "vitest run test/integration.test.ts",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@ai-coustics/aic-sdk": "^0.21.0"
  },
  "peerDependencies": {
    "@livekit/agents": ">=1.0.43 <2",
    "@livekit/rtc-node": ">=0.13.24 <1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@livekit/agents": "^1.0.43",
    "@livekit/rtc-node": "^0.13.24",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
